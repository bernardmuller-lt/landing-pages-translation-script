      "__component": "ai-chat.hero-section",
      "id": 99,
      "fe_component": "Hero",
      "title": "<h1 class=\"text-[30px] lg:text-[40px] font-bold mb-2.5 leading-[1.1]\">AI Chat: <strong class=\"font-black\">Multiple AI</strong><br><strong class=\"font-black\">Models, </strong>One Powerful Platform</h1>",
      "description": "<p class=\"text-highlight mt-6.5 leading-[1.167] text-[22px] md:text-2xl font-bold\">Chat with different AI models to find yours</p><p class=\"mt-5 mb-8 leading-[1.286] text-sm text-variant dark:text-white\">Discover a world of AI in one place. Chat with different models, compare their strengths, and get the most out of AI technology. Whether you need accurate research, content creation, language translation, image generation or coding assistance, we have the right model for you.</p>",
